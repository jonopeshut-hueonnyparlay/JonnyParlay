# JonnyParlay secrets template — COPY to .env and fill in real values.
# .env is gitignored; this .env.example file is safe to commit.
#
# On Windows, the canonical location is:
#   C:\Users\jono4\Documents\JonnyParlay\.env
#
# engine/secrets_config.py also searches:
#   <project-root>/.env   (one level above engine/)
#   engine/.env

# ── Odds API ─────────────────────────────────────────────────────
# The Odds API key. Get one at https://the-odds-api.com/
ODDS_API_KEY=your-odds-api-key-here

# ── Discord webhooks ─────────────────────────────────────────────
# Each webhook maps to one channel in the picksbyjonny Discord server.
# Create / rotate at: Channel Settings → Integrations → Webhooks

DISCORD_WEBHOOK_URL=         # #premium-portfolio
DISCORD_BONUS_WEBHOOK=       # #bonus-drops
DISCORD_ALT_PARLAY_WEBHOOK=  # #daily-lay
DISCORD_RECAP_WEBHOOK=       # #daily-recap
DISCORD_KILLSHOT_WEBHOOK=    # #killshot
DISCORD_MONTHLY_WEBHOOK=     # #monthly-tracker
DISCORD_ANNOUNCE_WEBHOOK=    # #announcements
DISCORD_LONGSHOT_WEBHOOK=    # #longshot (optional — falls back to #bonus-drops if blank)
DISCORD_SGP_WEBHOOK=         # #sgp     (optional — falls back to #bonus-drops if blank)
DISCORD_FALLBACK_WEBHOOK=    # optional alert channel (H-7)
DISCORD_GAME_LINES_WEBHOOK=  # #game-lines (optional — prints to console if blank)
